# =========================================================
# GameHub — optional local overrides.
# Copy to .env (git-ignored) and edit. Every value has a working
# default in docker-compose.yml, so this file is only needed when
# you want to change something.
# =========================================================

# --- database -------------------------------------------------
# DB_USER=gamehub
# DB_PASSWORD=gamehub_local_pw
# MYSQL_ROOT_PASSWORD=gamehub_root_local
# DB_NAME=gamehub

# --- API ------------------------------------------------------
# Comma-separated allow-list. Local dev is the default.
# CORS_ORIGIN=http://localhost:8080

# --- Cognito sign-in gate -------------------------------------
# Leave empty for local development: the API stays open and the
# backend logs `auth_disabled` at boot. Fill all three in to enforce
# sign-in exactly like the deployed stack does.
# COGNITO_REGION=eu-central-1
# COGNITO_USER_POOL_ID=
# COGNITO_CLIENT_ID=

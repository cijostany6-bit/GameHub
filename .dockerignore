# Build-context filter for the frontend image (context = repo root)
.git
.gitignore
.github
**/.DS_Store
**/node_modules
backend/.env
.env
.env.*
*.md
docs/
# learn/ is NOT ignored: production uploads frontend/ + learn/ to the same
# bucket, so the image must contain both for /learn/ to work locally and in
# kind, exactly as it does behind CloudFront.
tests/
scripts/
db/
docker-compose.yml
Makefile

# =========================================================
# GameHub backend — environment template
#
# Copy to `.env` ONLY for running the server outside Docker
# (`node server.js`). Never commit a real `.env`.
#
# Inside Docker Compose none of this is needed: the values
# in docker-compose.yml already default to the local stack.
# =========================================================

# HTTP
PORT=3000
# Origins allowed to call the API directly (same-origin via
# nginx makes this mostly moot, but no wildcards).
CORS_ORIGIN=http://localhost:8080

# Database — local Docker Compose defaults:
DB_HOST=localhost
DB_PORT=3306
DB_USER=gamehub
DB_PASSWORD=gamehub_local_pw
DB_NAME=gamehub
DB_SSL=false

# Database — managed (RDS) in Phase 4 will look like:
# DB_HOST=your-instance.xxxx.eu-central-1.rds.amazonaws.com
# DB_SSL=true
